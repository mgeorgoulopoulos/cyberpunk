{
  "version": 3,
  "configurePresets": [
    {
      "name": "vs2022",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-vs"
    },
    {
      "name": "release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "vs-debug", "configurePreset": "vs2022", "configuration": "Debug" },
    { "name": "vs-release", "configurePreset": "vs2022", "configuration": "RelWithDebInfo" },
    { "name": "release", "configurePreset": "release" }
  ]
}
